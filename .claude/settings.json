{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:crosscheck)",
      "Bash(npm run test:publish)",
      "Bash(npm run test:xreply)",
      "Bash(npm run test:postdraft)",
      "Bash(npm run test:drift)",
      "Bash(node scripts/verify-ui-remote.mjs *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git branch *)"
    ],
    "deny": [
      "Read(./.dev.vars)",
      "Edit(./.dev.vars)",
      "Write(./.dev.vars)",
      "Edit(./package-lock.json)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * main)"
    ],
    "ask": ["Bash(git push*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start.mjs",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
