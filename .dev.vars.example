# Copy to .dev.vars for local dev with `npm run dev`. NEVER commit .dev.vars.
# Production values are set in the Cloudflare Pages dashboard (see TRY_TOOL_README.md).

# Dedicated Anthropic key for the /try tool (separate from the app's key, $50/mo spend limit).
ANTHROPIC_API_KEY_TRY=

# Kill switch: anything other than the exact string "true" disables the endpoint (503).
TRY_TOOL_ENABLED=true

# Daily spend cap in USD (UTC day). Launch-day raise: set to 25 in the dashboard.
DAILY_BUDGET_USD=5

# ---- /api/publish (owner-only auto-post) ------------------------------------
# Publishing is a live, irreversible action, so it is OFF unless PUBLISH_ENABLED
# is exactly "true". /try is a public tool — the PUBLISH_TOKEN gate is what stops
# a random visitor from posting as your account. Keep PUBLISH_TOKEN long/random.
PUBLISH_ENABLED=false
PUBLISH_TOKEN=

# X (Twitter) OAuth 1.0a — create an app + user access token in the X developer
# portal for the account you post as (e.g. @brypoai), with Read+Write permission.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Generic outbound webhook for platforms without a usable write API (note,
# LinkedIn) or that need a video pipeline (TikTok, YouTube). Point it at a
# Zapier / Make / n8n hook; it receives { format_type, language, text, content }.
PUBLISH_WEBHOOK_URL=

# Max publishes per UTC day (counter shares the TRY_KV namespace). A backstop
# that bounds the damage if PUBLISH_TOKEN leaks. Optional; defaults to 50.
PUBLISH_DAILY_LIMIT=50

# ---- /api/x-reply (owner-only auto-reply engine) -----------------------------
# Growth engine (dev-env docs/dev-env/x-growth-strategy.md). Reuses the X_* and
# ANTHROPIC_API_KEY_TRY / PUBLISH_TOKEN above. OFF unless X_REPLY_ENABLED is
# exactly "true" (kill switch). Auto-sends replies (no human approval) within
# deterministic guardrails — keep it off until the X read tier is funded.
X_REPLY_ENABLED=false
# Max auto-sent replies per UTC day. Optional; defaults to 20.
X_REPLY_DAILY_CAP=20
# Comma-separated words that drop a draft if present. Optional.
X_REPLY_NG_WORDS=
# Override the drafting model. Optional; defaults to the /try model (Haiku).
X_REPLY_MODEL=

# ---- /api/post-draft (owner-only daily X post draft, shown on /ops) ----------
# Reuses PUBLISH_TOKEN (gate), ANTHROPIC_API_KEY_TRY (drafting, shared $50/mo
# cap) and DAILY_BUDGET_USD (same daily gate /try enforces). One generation per
# JST day, cached in TRY_KV; nothing is ever sent — the draft is display-only.
# To turn it off, unset ANTHROPIC_API_KEY_TRY (/ops then prints that as the
# reason). Note that also turns off /try generation — they share the key.
# Override the drafting model. Optional; defaults to claude-opus-5.
POST_DRAFT_MODEL=

# ---- /api/metrics (owner-only KPI snapshot) ----------------------------------
# Tally API key (Tally → Settings → API keys) for the waitlist signup count.
# Optional: unset → the waitlist column stays a fill-by-hand cell.
TALLY_API_KEY=
# Waitlist form id; optional, defaults to the LP embed (dWQlbq).
TALLY_FORM_ID=
